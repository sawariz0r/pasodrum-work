{
  "name": "pasodrum-work",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pasodrum/web dev",
    "typecheck": "pnpm -r typecheck && tsc -p dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:matrix": "vitest run --root apps/web --config vitest.matrix.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm locales",
    "locales": "node scripts/check-locales.ts",
    "dev:server": "docker compose -f dev/docker-compose.yml --env-file dev/.env up -d",
    "dev:server:stop": "docker compose -f dev/docker-compose.yml --env-file dev/.env down",
    "dev:server:reset": "docker compose -f dev/docker-compose.yml --env-file dev/.env down -v && rm -rf dev/data",
    "dev:server:logs": "docker compose -f dev/docker-compose.yml --env-file dev/.env logs -f continuwuity",
    "dev:seed": "node dev/seed.ts",
    "probe": "node dev/probe.ts",
    "setup:prod": "bash scripts/setup-production-env.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
