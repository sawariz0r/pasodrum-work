# Copy to dev/.env. Any long random strings.
# The invite service holds the registration token (D-07) and encrypts temporary passwords with INVITE_SECRET (≥32 chars).
REGISTRATION_TOKEN=change-me-to-a-long-random-string
INVITE_SECRET=change-me-to-another-long-random-string-of-64-chars
# D-38: CONFIRM_KEY_SECRET (≥32 chars) locks the clients' held keys; losing it means every client starts fresh.
# SYSTEM_PASSWORD is the system sender "Pasodrum"; the invite service creates it at startup. Without it, help messages fail.
CONFIRM_KEY_SECRET=change-me-to-a-third-long-random-string-of-64-chars
SYSTEM_PASSWORD=change-me-to-a-fourth-long-random-string
# Optional: Translate (off without both).
# OPENAI_API_KEY=
# TRANSLATE_MODEL=gpt-6-luna
# TRANSLATE_DAILY_LIMIT=2000

# Optional: the Assistant (SIDE-14), off without its own key. Defaults shown; prices are USD per million tokens.
# ASSISTANT_OPENAI_API_KEY=
# ASSISTANT_QUICK=gpt-6.2-sol:low
# ASSISTANT_THOROUGH=gpt-6.2-astra:medium
# ASSISTANT_PRICES={"gpt-6.2-sol":{"in":2,"cached":0.1,"write":2.5,"out":10},"gpt-6.2-astra":{"in":8,"cached":0.4,"write":10,"out":40}}
# ASSISTANT_DAY_USD=3
# ASSISTANT_MONTH_USD=100
# ASSISTANT_DB_PATH=/data/assistant.db
