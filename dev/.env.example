# Copy to dev/.env. Any long random strings.
# The invite service holds the registration token (D-07) and encrypts temporary passwords with INVITE_SECRET (≥32 chars).
REGISTRATION_TOKEN=change-me-to-a-long-random-string
INVITE_SECRET=change-me-to-another-long-random-string-of-64-chars
# Optional: Translate (off without both).
# OPENAI_API_KEY=
# TRANSLATE_MODEL=gpt-6-luna
# TRANSLATE_DAILY_LIMIT=2000
