{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "remote": { "urls": ["http://localhost:4173/*", "http://localhost:5173/*"] },
  "permissions": [
    "core:event:default",
    "core:window:allow-set-badge-count",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
