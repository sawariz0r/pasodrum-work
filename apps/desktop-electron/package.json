{
  "name": "pasodrum-desktop-electron",
  "productName": "Pasodrum work",
  "version": "1.0.1",
  "private": true,
  "description": "Pasodrum work for Mac",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac --arm64 --dir -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "release": "rm -rf release && CSC_NAME=\"PRPL development AB (754ZSYKPH7)\" APPLE_KEYCHAIN_PROFILE=pasodrum-notary electron-builder --mac --arm64 --publish never",
    "publish:feed": "cd release && rsync -av Pasodrum-work-*.zip* Pasodrum-work.dmg \"$PASODRUM_DOWNLOADS\" && rsync -av latest-mac.yml \"$PASODRUM_DOWNLOADS\""
  },
  "build": {
    "appId": "work.pasodrum.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "space-grotesk-700.woff2",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "Pasodrum-work-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Pasodrum-work.dmg"
    },
    "publish": {
      "provider": "generic",
      "url": "https://pasodrum.work/download/mac"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
